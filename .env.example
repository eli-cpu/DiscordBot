# Discord bot token (required). Get one from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# Directory where downloaded/cached Opus audio and the SQLite metadata DB live.
# Defaults to ./cache
CACHE_DIR=./cache

# Maximum cache size in bytes. Defaults to 4 GB (4294967296).
CACHE_MAX_BYTES=4294967296

# Seconds to wait with an empty queue before auto-disconnecting. Defaults to 300.
IDLE_TIMEOUT_SECONDS=300
